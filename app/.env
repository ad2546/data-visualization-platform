# Application Configuration
PORT=8000

# File Upload Limits
MAX_FILE_SIZE_MB=1024
MAX_DIRECT_PROCESSING_SIZE_MB=100

# Session Management
SESSION_CLEANUP_HOURS=24

# Logging Configuration
LOG_LEVEL=INFO

# Optional: Places API (if needed for location-based visualizations)
